<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <title>Document</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #f8f6f2;
            --white: #ffffff;
            --text: #222222;
            --gray: #77716a;
            --brown: #9b6b46;
            --dark-brown: #70482e;
            --border: #e5ded6;
        }

        body {
            font-family: Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            scroll-behavior: smooth;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }


        /* ================= HEADER ================= */

        .header {
            width: 100%;
            height: 75px;
            padding: 0 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
        }


        /* PHOTO IN HEADER */

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 25px;
            font-weight: bold;
        }

        .logo img {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
            object-position: center top;
            border: 2px solid var(--brown);
        }

        .logo span {
            color: var(--brown);
        }


        .nav {
            display: flex;
            gap: 32px;
        }

        .nav a {
            font-size: 14px;
            font-weight: 600;
            color: var(--gray);
            transition: 0.3s;
        }

        .nav a:hover,
        .nav a.active {
            color: var(--brown);
        }


        .theme-btn,
        .menu-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            background: var(--white);
            cursor: pointer;
            border-radius: 50%;
        }

        .menu-btn {
            display: none;
            border-radius: 8px;
        }


        /* ================= HERO ================= */

        .hero {
            width: 86%;
            max-width: 1150px;
            min-height: calc(100vh - 75px);
            margin: auto;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            align-items: center;
            gap: 70px;
        }

        .small-title {
            color: var(--brown);
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 3px;
            margin-bottom: 15px;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: clamp(42px, 5vw, 70px);
            line-height: 1.1;
        }

        .hero h1 span {
            color: var(--brown);
        }

        .description {
            max-width: 600px;
            color: var(--gray);
            margin: 25px 0 30px;
            font-size: 16px;
        }


        /* BUTTONS */

        .buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 13px 23px;
            background: var(--brown);
            color: white;
            border: 1px solid var(--brown);
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn:hover {
            background: var(--dark-brown);
            transform: translateY(-2px);
        }

        .btn.outline {
            background: transparent;
            color: var(--text);
        }


        /* STATS */

        .stats {
            display: flex;
            gap: 35px;
            margin-top: 45px;
        }

        .stats div {
            display: flex;
            flex-direction: column;
        }

        .stats small {
            color: var(--gray);
        }


        /* HERO PHOTO */

        .hero-image {
            position: relative;
            width: min(420px, 100%);
            margin: auto;
        }

        .hero-image img {
            width: 100%;
            height: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            object-position: center top;
            border-radius: 50%;
            display: block;
            position: relative;
            object-fit: cover;
            z-index: 2;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
            
        }

        .circle {
            position: absolute;
            width: 110%;
            height: 90%;
            border: 1px solid var(--brown);
            border-radius: 50%;
            display: none;
            left: -5%;
            top: 3%;
            transform: rotate(-8deg);
            
        }

        .image-card {
            position: absolute;
            z-index: 5;
            bottom: 30px;
            left: -30px;
            background: var(--white);
            border: 1px solid var(--border);
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 10px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        }

        .image-card span {
            color: var(--brown);
            font-size: 22px;
        }

        .image-card b,
        .image-card small {
            display: block;
        }

        .image-card b {
            font-size: 12px;
        }

        .image-card small {
            color: var(--gray);
            font-size: 11px;
        }


        /* ================= SECTIONS ================= */

        .section {
            width: 86%;
            max-width: 1150px;
            margin: auto;
            padding: 110px 0;
        }

        .heading h2 {
            font-family: Georgia, serif;
            font-size: clamp(38px, 4.5vw, 55px);
            line-height: 1.1;
        }

        .heading h2 span {
            color: var(--brown);
        }

        .center {
            text-align: center;
        }


        /* ================= ABOUT ================= */

        .about-container {
            margin-top: 55px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .about-box {
            background: var(--white);
            border: 1px solid var(--border);
            padding: 30px;
            border-radius: 14px;
            transition: 0.3s;
        }

        .about-box:hover {
            transform: translateY(-7px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        }

        .about-box>span {
            color: var(--brown);
            font-size: 12px;
            font-weight: bold;
        }

        .about-box h3 {
            margin: 35px 0 12px;
            font-size: 21px;
        }

        .about-box p {
            color: var(--gray);
            font-size: 14px;
        }


        /* ================= SKILLS ================= */

        .skills-section {
            width: 100%;
            max-width: none;
            padding-left: 7%;
            padding-right: 7%;
            background: var(--white);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .skills {
            max-width: 900px;
            margin: 55px auto 30px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px 50px;
        }

        .skill-name {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .skill-name b {
            color: var(--brown);
        }

        .progress {
            height: 6px;
            background: var(--border);
            border-radius: 20px;
            overflow: hidden;
        }

        .progress i {
            display: block;
            height: 100%;
            background: var(--brown);
        }

        .tags {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .tags span {
            padding: 8px 15px;
            border: 1px solid var(--border);
            border-radius: 30px;
            color: var(--gray);
            font-size: 12px;
        }


        /* ================= PROJECTS ================= */

        .project-description {
            color: var(--gray);
            margin-top: 15px;
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-top: 50px;
        }

        .project {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 30px;
            min-height: 340px;
            transition: 0.3s;
        }

        .project:hover {
            transform: translateY(-7px);
        }

        .project.featured {
            background: var(--brown);
            color: white;
        }

        .project-icon {
            font-size: 40px;
            color: var(--brown);
            margin-bottom: 35px;
        }

        .featured .project-icon {
            color: white;
        }

        .project>p {
            color: var(--brown);
            letter-spacing: 2px;
            font-size: 10px;
            font-weight: bold;
        }

        .featured>p {
            color: white;
        }

        .project h3 {
            font-family: Georgia, serif;
            font-size: 28px;
            margin: 8px 0;
        }

        .project>span {
            display: block;
            color: var(--gray);
            font-size: 14px;
        }

        .featured>span {
            color: rgba(255, 255, 255, 0.8);
        }

        .view-project {
            border: none;
            background: transparent;
            color: var(--brown);
            font-weight: bold;
            cursor: pointer;
            margin-top: 25px;
        }

        .featured .view-project {
            color: white;
        }


        /* ================= CONTACT ================= */

        .contact {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 55px;
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 70px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        }

        .contact-info h2 {
            font-family: Georgia, serif;
            font-size: clamp(40px, 5vw, 60px);
            line-height: 1.1;
        }

        .contact-info h2 span {
            color: var(--brown);
        }

        .contact-info p:last-child {
            color: var(--gray);
            margin-top: 20px;
        }

        form {
            display: grid;
            gap: 16px;
        }

        label {
            font-size: 12px;
            font-weight: bold;
        }

        input,
        textarea {
            display: block;
            width: 100%;
            margin-top: 7px;
            padding: 13px;
            border: 1px solid var(--border);
            border-radius: 6px;
            outline: none;
            background: var(--bg);
            color: var(--text);
            resize: vertical;
        }

        input:focus,
        textarea:focus {
            border-color: var(--brown);
        }

        #formMessage {
            color: var(--brown);
            font-size: 13px;
        }


        /* ================= FOOTER ================= */

        footer {
            min-height: 90px;
            border-top: 1px solid var(--border);
            padding: 25px 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .footer-logo {
            font-size: 27px;
            font-weight: bold;
        }

        .footer-logo span {
            color: var(--brown);
        }

        footer p,
        footer a {
            color: var(--gray);
            font-size: 12px;
        }


        /* ================= MODAL ================= */

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.65);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 200;
            padding: 20px;
        }

        .modal.show {
            display: flex;
        }

        .modal-box {
            width: min(500px, 100%);
            background: var(--white);
            padding: 35px;
            border-radius: 15px;
            position: relative;
        }

        .modal-box h2 {
            font-family: Georgia, serif;
            font-size: 40px;
        }

        .modal-box p:not(.small-title) {
            color: var(--gray);
            margin: 15px 0 25px;
        }

        #closeModal {
            position: absolute;
            right: 15px;
            top: 10px;
            border: none;
            background: transparent;
            font-size: 28px;
            cursor: pointer;
        }


        /* ================= MOBILE ================= */

        @media (max-width: 850px) {

            .header {
                padding: 0 5%;
            }

            .menu-btn {
                display: block;
                margin-left: auto;
                margin-right: 10px;
            }

            .nav {
                display: none;
                position: absolute;
                top: 70px;
                left: 5%;
                right: 5%;
                background: var(--white);
                border: 1px solid var(--border);
                padding: 15px;
                border-radius: 10px;
                flex-direction: column;
                gap: 0;
            }

            .nav.show {
                display: flex;
            }

            .nav a {
                padding: 12px;
            }

            .hero {
                grid-template-columns: 1fr;
                text-align: center;
                padding-top: 70px;
            }

            .hero-image {
                order: -1;
                width: min(350px, 90%);
            }

            .description {
                margin-left: auto;
                margin-right: auto;
            }

            .buttons,
            .stats {
                justify-content: center;
            }

            .about-container,
            .projects {
                grid-template-columns: 1fr;
            }

            .skills {
                grid-template-columns: 1fr;
            }

            .contact {
                grid-template-columns: 1fr;
                padding: 30px;
                gap: 35px;
            }

            footer {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }
        }

        @media (max-width: 500px) {

            .section,
            .hero {
                width: 90%;
            }

            .hero h1 {
                font-size: 40px;
            }

            .logo img {
                width: 38px;
                height: 38px;
            }
        }
    </style>
</head>

<body>

